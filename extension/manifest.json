{
  "manifest_version": 3,
  "name": "The Recall Trial",
  "version": "0.1.0",
  "description": "A philosopher trial that tests what you actually recall from YouTube Shorts.",
  "permissions": ["storage", "activeTab", "tabs"],
  "host_permissions": [
    "https://www.youtube.com/*",
    "http://localhost:3000/*",
    "https://*.vercel.app/*"
  ],
  "action": {
    "default_title": "The Recall Trial",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["assets/*", "assets/Images/*", "assets/AceAttorney/*", "assets/sound/*"],
      "matches": ["https://www.youtube.com/*"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ]
}
